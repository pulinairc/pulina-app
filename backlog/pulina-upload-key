#!/bin/sh
# pulina-upload-key <account>: lets an account's lobby-server put files on up.pulina.fi, which
# stores them in R2 (uploads-worker/). The config is written as that user, so nothing in their
# home can redirect root. Run as root.
set -eu
NAME=$1
case "$NAME" in [a-z]*) ;; *) echo "bad name" >&2; exit 1 ;; esac
case "$NAME" in *[!a-z0-9_-]*) echo "bad name" >&2; exit 1 ;; esac
HOME_DIR=$(getent passwd "$NAME" | cut -d: -f6)
CONF="$HOME_DIR/.config/lobby-server/config.toml"
runuser -u "$NAME" -- grep -q '^\[upload\]' "$CONF" && { echo "$NAME already has uploads"; exit 0; }
printf '\n[upload]\nkind = "filehost"\nurl = "https://up.pulina.fi/pulina"\n' | runuser -u "$NAME" -- sh -c 'cat >> "$1"' sh "$CONF"
systemctl try-restart "lobby-server@$NAME.service"
echo "$NAME can upload"
