# One always-on IRC connection per Pulina account, run as that account' own user so identd names it.
# Install: /etc/systemd/system/lobby-server@.service
[Unit]
Description=lobby-server for Pulina account %i
After=network-online.target
Wants=network-online.target

[Service]
User=%i
Group=%i
ExecStart=/usr/local/bin/lobby-server
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
# Only its own home is there at all; other users' homes and the accounts' secrets are not.
ProtectHome=tmpfs
BindPaths=/home/%i
InaccessiblePaths=-/etc/pulina-accounts.env -/var/lib/pulina-accounts
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=96M

[Install]
WantedBy=multi-user.target
