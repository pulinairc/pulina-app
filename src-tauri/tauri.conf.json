{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulina",
  "identifier": "fi.pulina.app",
  "mainBinaryName": "pulina",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pulina",
        "width": 440,
        "height": 720,
        "minWidth": 300,
        "minHeight": 320,
        "dragDropEnabled": false,
        "backgroundColor": "#060d21"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; media-src https: http:; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyOEMxMzdGMTdEOTRGNDMKUldSRFQ5a1hmeE9NWWlYREZpMEF3YWpKUDBSTjdqdTJUMDZxem1DQ0JuMDJ6SUJDY0srUDFqYkUK",
      "endpoints": [
        "https://github.com/rollecode/lobby/releases/latest/download/latest.json"
      ]
    }
  }
}
